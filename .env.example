# Web ONLY. Copy to .env.local for pnpm, or .env for Docker Compose.
# Empty Supabase values show a disabled, clearly labelled UI preview.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Must exactly match the URL used in the browser; HTTPS in production.
APP_ORIGIN=http://localhost:3000
# Keep in sync with the worker; only simulation currently publishes no real posts.
WORKER_MODE=simulation
# No service-role or social platform secrets belong in this file / web container.
