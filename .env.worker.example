# Copy to .env.worker. Used ONLY by the cloud worker, never the web container.
SUPABASE_URL=
# Legacy Supabase service_role JWT for the REST RPC worker. Keep private.
SUPABASE_SERVICE_ROLE_KEY=
WORKER_MODE=simulation
POLL_SECONDS=5
LEASE_SECONDS=300
# Live platform adapters and credentials will be configured in a later phase.
